# Copiar a .env y completar. Nunca subir .env al repositorio.

PORT=3020
NODE_ENV=development

# URL base del sistema. QUEDA IMPRESA EN CADA TARJETA: no se puede cambiar despues.
URL_BASE=http://localhost:3020

# Firma de las cookies de sesion. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PROBACARD_SECRET=cambiar-en-produccion

# MySQL (Fase 1). Mientras tanto el sistema usa data/db.json
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=probacard

# Fotos de clientes
UPLOADS_DIR=./uploads

# WhatsApp para la bienvenida y avisos (Fase 2)
WHATSAPP_TOKEN=
